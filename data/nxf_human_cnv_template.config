params {
    cnv = true
    // в эту директорию помещаем все BAM образца
    bam = "{{ bam_dir }}"
    ref = "/mnt/cephfs8_rw/nanopore2/service/reference/human/hg38/no_alt"
    bam_min_coverage = 20
    out_dir = "{{ cnv_out_dir }}"
    threads = {{ threads_per_cnv_calling }}
    phased = true
    override_basecaller_cfg = "{{ basecalling_model }}"
}

report {
    enabled = true
    file = "{{ report_file }}"
    overwrite = true
    }

trace {
    enabled = true
    file = "{{ trace_file }}"
    overwrite = true
    }

timeline {
    enabled = true
    file = "{{ timeline_file }}"
    overwrite = true
    }

workDir = "{{ sample_work_dir }}"